// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// NextAuth Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Bot/SaaS Models
model SubscriptionPlan {
  id               String   @id @default(cuid())
  name             String   @unique // Free, Pro, Creator
  price            Float
  maxFaqs          Int      @default(10)
  autoPostsPerWeek Int      @default(3)
  features         String[] // JSON array of features
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  guildSettings GuildSettings[]
}

model Guild {
  id        String   @id // Discord Guild ID
  name      String
  ownerId   String
  icon      String?
  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings       GuildSettings?
  members        MemberActivity[]
  autoPosts      AutoPostSchedule[]
  faqs           FAQItem[]
  weeklyReports  WeeklyReport[]
  ignoredChannels IgnoredChannel[]

  auditLogs           AuditLog[]
  creatorIntegrations CreatorIntegration[]
  youtubeIntegrations YoutubeIntegration[]
  clipSubmissions     ClipSubmission[]
  clipSettings        ClipSettings?
  shortIdeas          ShortIdea[]
  liveAnnouncementLogs LiveAnnouncementLog[]
  youtubeAnnouncementLogs YoutubeAnnouncementLog[]
}

model GuildSettings {
  id            String   @id @default(cuid())
  guildId       String   @unique
  guild         Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  
  autoPostChannelId String?
  rankingChannelId  String?
  logChannelId      String?
  
  language          String   @default("pt-BR") // pt-BR, en-US
  niche             String   @default("variedades") // games, anime, tech, variedades
  streamerName      String?
  autoPostPaused    Boolean  @default(false)
  weeklyReportChannelId String?
  
  // Links
  twitchUrl         String?
  youtubeUrl        String?
  tiktokUrl         String?
  instagramUrl      String?
  kickUrl           String?
  websiteUrl        String?

  planId            String?
  plan              SubscriptionPlan? @relation(fields: [planId], references: [id])
  
  astraAdminRoleId  String? // Cargo de admin do Astra
  
  // Feature Flags
  liveEnabled       Boolean  @default(true)
  youtubeEnabled    Boolean  @default(true)
  clipsEnabled      Boolean  @default(true)
  shortsEnabled     Boolean  @default(true)
  scheduleEnabled   Boolean  @default(true)
  missionsEnabled   Boolean  @default(true)
  welcomeEnabled    Boolean  @default(true)
  rolesEnabled      Boolean  @default(true)
  giveawaysEnabled  Boolean  @default(true)
  stickyEnabled     Boolean  @default(true)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model MemberActivity {
  id            String   @id @default(cuid())
  guildId       String
  userId            String // Discord User ID
  messageCount      Int      @default(0)
  weeklyMessageCount Int     @default(0)
  monthlyMessageCount Int    @default(0)
  lastMessageAt     DateTime @default(now())
  
  guild         Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
}

model IgnoredChannel {
  id        String   @id @default(cuid())
  guildId   String
  channelId String
  
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, channelId])
}

model AutoPostSchedule {
  id        String   @id @default(cuid())
  guildId   String
  channelId String
  frequency String   // daily, 3_per_week, weekly
  time      String   // HH:mm
  type      String   // question, poll, challenge, meme, etc
  active    Boolean  @default(true)
  
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  logs      AutoPostLog[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AutoPostLog {
  id         String   @id @default(cuid())
  scheduleId String
  content    String   @db.Text
  sentAt     DateTime @default(now())
  success    Boolean  @default(true)
  error      String?  @db.Text

  schedule   AutoPostSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
}

model FAQItem {
  id        String   @id @default(cuid())
  guildId   String
  question  String   @db.Text
  answer    String   @db.Text
  
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WeeklyReport {
  id           String   @id @default(cuid())
  guildId      String
  weekStart    DateTime
  weekEnd      DateTime
  totalMessages Int
  reportText   String   @db.Text
  sentAt       DateTime @default(now())
  
  guild        Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

// Audit Logs
model AuditLog {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  action    String
  metadata  String?  @db.Text
  createdAt DateTime @default(now())

  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
}

// Fase 3.1 - Live Connect
model CreatorIntegration {
  id               String   @id @default(cuid())
  guildId          String
  platform         String   // twitch, youtube, kick
  creatorUsername  String
  discordChannelId String
  mentionRoleId    String?
  customMessage    String?  @db.Text
  lastLiveId       String?
  lastAnnouncedAt  DateTime?
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  guild            Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  logs             LiveAnnouncementLog[]

  @@unique([guildId, platform, creatorUsername])
  @@index([guildId, platform, enabled])
}

model LiveAnnouncementLog {
  id            String   @id @default(cuid())
  guildId       String
  integrationId String
  platform      String
  liveId        String
  title         String   @db.Text
  url           String
  announcedAt   DateTime @default(now())

  guild         Guild              @relation(fields: [guildId], references: [id], onDelete: Cascade)
  integration   CreatorIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([guildId, platform])
}

// Fase 3.1 - YouTube Connect
model YoutubeIntegration {
  id                 String   @id @default(cuid())
  guildId            String
  youtubeChannelId   String
  youtubeChannelName String
  discordChannelId   String
  mentionRoleId      String?
  lastVideoId        String?
  enabled            Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  guild              Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  logs               YoutubeAnnouncementLog[]

  @@unique([guildId, youtubeChannelId])
  @@index([guildId, enabled])
}

model YoutubeAnnouncementLog {
  id            String   @id @default(cuid())
  guildId       String
  integrationId String
  videoId       String
  title         String   @db.Text
  url           String
  announcedAt   DateTime @default(now())

  guild         Guild              @relation(fields: [guildId], references: [id], onDelete: Cascade)
  integration   YoutubeIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

// Fase 3.1 - Sistema de Clipes
model ClipSettings {
  id                String   @id @default(cuid())
  guildId           String   @unique
  submissionChannelId String?
  approvedChannelId   String?
  logsChannelId       String?

  guild             Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model ClipSubmission {
  id            String   @id @default(cuid())
  guildId       String
  userId        String
  username      String
  url           String
  description   String?  @db.Text
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED, FEATURED
  reviewedBy    String?
  reviewReason  String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  guild         Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, status])
}

// Fase 3.1 - Ideias para Shorts
model ShortIdea {
  id          String   @id @default(cuid())
  guildId     String
  createdBy   String
  title       String
  hook        String   @db.Text
  script      String   @db.Text
  niche       String
  status      String   @default("SAVED") // SAVED, USED, ARCHIVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, status])
}
