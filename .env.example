# Database (PostgreSQL via Supabase, Neon, ou Local)
DATABASE_URL="postgresql://user:password@localhost:5432/astra"

# Discord Bot
DISCORD_BOT_TOKEN="seu_token_aqui"
DISCORD_CLIENT_ID="seu_client_id_aqui"
DISCORD_CLIENT_SECRET="seu_client_secret_aqui"

# Dev/Test (Opcional, para registrar slash commands rapidamente)
DISCORD_GUILD_ID_DEV="id_do_seu_servidor_de_teste"

# NextAuth (Gere um segredo com: openssl rand -base64 32)
AUTH_SECRET="seu_auth_secret_aqui"
AUTH_URL="http://localhost:3000/api/auth" # Ou URL do seu domínio em produção

# URLs
DASHBOARD_URL="http://localhost:3000"
SUPPORT_SERVER_URL="https://discord.gg/astra"

# AI (Opcional)
AI_ENABLED="false"
OPENAI_API_KEY=""
